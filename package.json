{
  "name": "meu-bot",
  "productName": "meu-bot",
  "version": "0.84.0",
  "private": true,
  "description": "Bot de mesa pessoal: chat com Claude e execução aprovada na sua VM",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json && cp src/main/terminal/pty-broker.py dist/main/terminal/",
    "build:renderer": "tsc -p tsconfig.renderer.json && node scripts/vendor.mjs && cp src/renderer/index.html src/renderer/style.css src/renderer/admin.css src/renderer/conta.css src/renderer/quick-entry.html src/renderer/quick-entry.css src/renderer/picker.html src/renderer/picker.css src/renderer/relief.html src/renderer/relief.css src/renderer/produtos.html src/renderer/usuarios-mac.html dist/renderer/",
    "build": "rm -rf dist && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "fuses": "node scripts/fuses.mjs",
    "dist": "node scripts/dist.mjs",
    "test": "npm run build && node --test scripts/tests/",
    "dmg": "npm run dist && node scripts/dmg.mjs",
    "dist:admin": "node scripts/dist.mjs --variant admin",
    "dist:admin-mac": "node scripts/dist.mjs --variant admin-mac",
    "build:extensao": "npm --prefix extensao-crm run build",
    "dev:extensao": "npm --prefix extensao-crm run dev",
    "dist:staging": "node scripts/dist.mjs --variant client-staging",
    "dmg:admin": "npm run dist:admin && node scripts/dmg.mjs --admin",
    "release": "node scripts/release.mjs",
    "release:staging": "node scripts/release.mjs --staging",
    "icons": "npm run build:main && node scripts/icons.mjs",
    "assinatura": "node scripts/assinatura.mjs --criar",
    "chave-release": "node scripts/chave-release.mjs",
    "chave-licenca": "node scripts/chave-licenca.mjs",
    "dist:finance-staging": "node scripts/dist.mjs --variant finance-staging"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "^1.5.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.17",
    "electron": "44.10.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "electron-chrome-web-store": "^0.13.0",
    "jsqr": "1.4.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
